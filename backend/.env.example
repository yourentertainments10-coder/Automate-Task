# ============================================================================
# CarTrends CRM -- environment configuration
#
# HOW TO USE:
#   1. Copy this file:            copy .env.example .env      (from backend\)
#   2. Fill in ONLY the values you have. Everything left blank stays OFF and
#      the app keeps working -- each integration switches on independently.
#   3. Restart the backend after editing.
#
# NOTE: This project is fully independent. Use NEW credentials created for
# THIS project only -- never reuse another project's tokens or database.
# ============================================================================


# ---------------------------------------------------------------------------
# CORE (works out of the box -- change SECRET_KEY before deploying)
# ---------------------------------------------------------------------------
# Any long random string. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true for local development, false on Render
DEBUG=true

# Comma-separated. "*" is fine locally; on Render use your host, e.g.
# cartrends-crm.onrender.com
ALLOWED_HOSTS=*

# Frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174


# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave BLANK for local SQLite (zero setup).
# For the NEW Neon Postgres (create a fresh project at https://neon.tech):
#   Neon dashboard -> your project -> "Connection string" -> copy the URI.
# Looks like:
#   postgresql://user:password@ep-xxxx-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Also run:  pip install "psycopg[binary]"   before switching to Postgres.
DATABASE_URL=


# ---------------------------------------------------------------------------
# WHATSAPP -- Meta WhatsApp Cloud API (direct, no BSP)
# Get these from https://developers.facebook.com -> your NEW app ->
# WhatsApp -> API Setup
# ---------------------------------------------------------------------------
# Master switch for SENDING WhatsApp notifications
WHATSAPP_ENABLED=false

# "Permanent token" (System User token with whatsapp_business_messaging
# permission). The 24h temporary token from API Setup works for testing.
WHATSAPP_ACCESS_TOKEN=

# "Phone number ID" shown under API Setup (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=

# App secret: App Settings -> Basic -> App Secret.
# Used to verify webhook signatures. STRONGLY recommended in production;
# if blank, incoming webhooks are accepted unverified (dev only).
WHATSAPP_APP_SECRET=

# Any string YOU invent (e.g. cartrends-verify-2026). Enter the SAME value
# in Meta's webhook config. Webhook callback URL to give Meta:
#   https://<your-backend-host>/api/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Graph API version (leave default unless Meta deprecates it)
WHATSAPP_GRAPH_API_VERSION=v23.0


# ---------------------------------------------------------------------------
# GMAIL -- Gmail API via Google OAuth (send notifications + poll inbox)
# One-time setup with the NEW Google Cloud project:
#   1. console.cloud.google.com -> new project -> enable "Gmail API"
#   2. OAuth consent screen -> Internal (or External+test user)
#   3. Credentials -> Create OAuth client ID -> Desktop app
#      -> gives you CLIENT_ID + CLIENT_SECRET
#   4. Get a refresh token for the CRM's Gmail account with scopes:
#      https://www.googleapis.com/auth/gmail.send
#      https://www.googleapis.com/auth/gmail.modify
#      (easiest: https://developers.google.com/oauthplayground --
#       gear icon -> "Use your own OAuth credentials" -> authorize both
#       scopes -> Exchange authorization code -> copy the refresh_token)
# ---------------------------------------------------------------------------
# Master switch for Gmail (sending AND inbox polling)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# The Gmail address the CRM sends from / polls (e.g. crm@cartrends.net)
GMAIL_SENDER=

# Inbox polling: how often (seconds) and which messages
GMAIL_POLL_SECONDS=120
GMAIL_POLL_QUERY=is:unread in:inbox category:primary


# ---------------------------------------------------------------------------
# AI -- Claude API (classification of incoming WhatsApp/Gmail messages)
# Create a key at https://console.anthropic.com -> API Keys
# When disabled/blank, a built-in keyword classifier takes over -- the
# pipeline still works, just less smart.
# ---------------------------------------------------------------------------
AI_ENABLED=false

# Starts with sk-ant-
ANTHROPIC_API_KEY=

# Model to use (Sonnet = good balance of cost/quality for classification)
ANTHROPIC_MODEL=claude-sonnet-5

# Give up on Claude after this many seconds and use the fallback classifier
AI_TIMEOUT_SECONDS=20


# ---------------------------------------------------------------------------
# LEAVE & ATTENDANCE (Phase 6)
# All optional -- these defaults work out of the box.
# ---------------------------------------------------------------------------
# Office timings (24h). Check-in after WORK_START + grace = "Late".
HR_WORK_START=09:30
HR_WORK_END=18:30
HR_LATE_GRACE_MINUTES=15

# Less than HALF_DAY_HOURS worked => Half Day
HR_HALF_DAY_HOURS=4
HR_FULL_DAY_HOURS=8

# Weekly offs as Python weekday numbers: Mon=0 ... Sun=6 (comma-separated).
# e.g. "5,6" for Saturday+Sunday off.
HR_WEEK_OFF_DAYS=6

# --- Geo-fencing -----------------------------------------------------------
# When true, check-in/out is REJECTED outside every active office radius.
# Add office locations in the app (HR -> Settings, admin only) first.
GEOFENCE_ENABLED=false

# --- Face-recognition attendance ------------------------------------------
# When true, check-in/out requires a face descriptor that matches the
# employee's admin-enrolled profile. Requires a client-side face model
# (e.g. face-api.js) to produce the descriptor vector; the server stores
# ONLY the numeric descriptor, never an image, and never marks attendance
# on a below-threshold match. Keep false until that is wired up.
FACE_RECOGNITION_ENABLED=false
# Max euclidean distance for a match (lower = stricter; 0.6 is typical).
FACE_MATCH_THRESHOLD=0.6


# ---------------------------------------------------------------------------
# BACKGROUND JOBS
# ---------------------------------------------------------------------------
# In-process follow-up reminder ticker (every 5 min). Set false if you
# prefer running "python manage.py send_reminders" from cron/Task Scheduler.
NOTIF_SCHEDULER=true
